# Copiá este archivo como .env.local y completá los valores.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# CLAVE SECRETA: solo servidor. Nunca con prefijo NEXT_PUBLIC_, nunca en el repositorio.
SUPABASE_SECRET_KEY=

# URL pública del sitio (sin barra final). En producción, el dominio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago → Tus integraciones → tu aplicación
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Solo si Mercado Pago lo pide al probar con credenciales de prueba: usa la URL de pago "sandbox".
MP_USE_SANDBOX=false

# Se pone en "true" recién cuando el checkout esté probado y listo para lanzar.
NEXT_PUBLIC_CHECKOUT_ENABLED=false

# Bunny Stream (videos). Biblioteca → Security → Embed view token authentication.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_AUTH_KEY=

# Mails automáticos (Resend). Sin estas variables la web funciona igual, pero no manda mails.
RESEND_API_KEY=
# Remitente: debe ser de un dominio verificado en Resend. Ej.: IA Nails <hola@tudominio.com.ar>
EMAIL_FROM=
# Quién recibe los avisos internos (arrepentimientos, pagos que no coinciden). Si queda vacío usa el mail de contacto.
NOTIFY_EMAIL=
